{
  "name": "playbook-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Playbook Studio: local web editor for Madden NFL 27 playbooks and plays (writes the JSON specs in ../playbooks).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "npm run build && node scripts/serve-dist.mjs --check",
    "preview:site": "node scripts/serve-dist.mjs",
    "guide": "node scripts/build-guide.mjs",
    "start": "node server/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
