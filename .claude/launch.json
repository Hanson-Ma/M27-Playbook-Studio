{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "playbook-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev",
        "--",
        "--port",
        "5178",
        "--strictPort"
      ],
      "port": 5178
    },
    {
      "name": "playcall",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/serve-static.mjs",
        "playcall",
        "5179"
      ],
      "port": 5179
    },
    {
      "name": "studio-built",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "start"
      ],
      "port": 5178
    },
    {
      "name": "docs",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/serve-static.mjs",
        "docs",
        "5180"
      ],
      "port": 5180
    }
  ]
}
